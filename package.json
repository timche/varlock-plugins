{
  "name": "varlock-plugins",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run --filter '@timche/*' build",
    "release": "bun run build && changeset publish",
    "test": "bun run build && bun test",
    "typecheck": "tsc -p ."
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@timche/oxc-configs": "^2.0.0",
    "@timche/varlock-require-all-or-none": "workspace:*",
    "@timche/varlock-skip-if-no-auth": "workspace:*",
    "@types/bun": "^1.4.2",
    "@varlock/1password-plugin": "^2.0.4",
    "typescript": "^7.0.2",
    "varlock": "1.21.1",
    "vite-plus": "^1.0.0"
  },
  "packageManager": "bun@1.4.2"
}
