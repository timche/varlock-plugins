# @plugin(@varlock/1password-plugin)
# @plugin(@timche/varlock-skip-if-no-auth)
# @initOp(token=$OP_TOKEN, allowAppAuth=$OP_APP_AUTH, useCliWithServiceAccount=true)
# @defaultSensitive=false
# ---
# @type=opServiceAccountToken @internal @optional @sensitive
OP_TOKEN=
# @type=boolean @internal
OP_APP_AUTH=false

# @optional @sensitive
API_KEY=skipIfNoAuth(op("op://Shared/Acme API/credential"))

# @type=boolean
SIGN=false
# @optional @sensitive
SIGNING_KEY=if($SIGN, skipIfNoAuth(op("op://Shared/Signing/password")))
